{
  "name": "ignore-drift",
  "version": "1.0.0",
  "description": "Audit which Git-ignored files escape into Docker contexts and npm packages.",
  "type": "module",
  "bin": {
    "ignore-drift": "bin/ignore-drift.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "bin",
    "src",
    "schema",
    "docs",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "types": "tsc --noEmit",
    "lint": "node scripts/check-syntax.js",
    "check": "npm run lint && npm run types && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dockerignore",
    "gitignore",
    "npmignore",
    "supply-chain",
    "docker",
    "security",
    "cli"
  ],
  "author": "sushinaito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushinaito/ignore-drift.git"
  },
  "bugs": {
    "url": "https://github.com/sushinaito/ignore-drift/issues"
  },
  "homepage": "https://github.com/sushinaito/ignore-drift#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@balena/dockerignore": "1.0.2",
    "picomatch": "4.0.7"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2"
  }
}
